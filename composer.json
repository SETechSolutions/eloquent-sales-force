{
    "name": "setechsolutions/eloquent-sales-force",
    "description": "Work with Salesforce objects as Eloquent models: an Eloquent driver for SOQL and the Salesforce REST API.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "salesforce",
        "soql",
        "sobjects",
        "forrest",
        "model",
        "orm"
    ],
    "homepage": "https://github.com/SETechSolutions/eloquent-sales-force",
    "support": {
        "issues": "https://github.com/SETechSolutions/eloquent-sales-force/issues",
        "source": "https://github.com/SETechSolutions/eloquent-sales-force",
        "docs": "https://setechsolutions.github.io/eloquent-sales-force/"
    },
    "authors": [
        {
            "name": "SETechSolutions",
            "homepage": "https://github.com/SETechSolutions",
            "role": "Maintainer"
        },
        {
            "name": "Robert Lester",
            "homepage": "https://github.com/roblesterjr04",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0 || ^13.0",
        "omniphx/forrest": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.5"
    },
    "replace": {
        "rob-lester-jr04/eloquent-sales-force": "*"
    },
    "autoload": {
        "psr-4": {
            "SETechSolutions\\EloquentSalesForce\\": "src"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SETechSolutions\\EloquentSalesForce\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "docs": "docsify serve ./docs"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SETechSolutions\\EloquentSalesForce\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
